# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
*.egg
wheels/
*.whl

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- uv ---
# uv.lock IS tracked (it pins reproducible dependency versions) —
# do not ignore it. Only local/cache artifacts are excluded here.
.uv/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Type checkers / linters ---
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Environment / secrets ---
.env
.env.*